# Local listener only. Version one rejects every non-loopback host.
TR_HOST=127.0.0.1
TR_PORT=8765
# Fixed hourly scan interval; other values are rejected.
TR_SCAN_INTERVAL_MINUTES=60
TR_BUDGET_CAP=400.00
TR_ALERT_PROFIT_THRESHOLD=50.00
TR_PROFIT_IMPROVEMENT_THRESHOLD=20.00
TR_OBSERVATION_FRESHNESS_MINUTES=120
# Seller fee rates are user assumptions, not marketplace guarantees.
TR_TICKETMASTER_SELLER_FEE_RATE=0.15
TR_SEATGEEK_SELLER_FEE_RATE=0.15
TR_STUBHUB_SELLER_FEE_RATE=0.15
TR_TIMEZONE=America/Chicago
# Keep the database local; the adjacent OS lock enforces one application process.
TR_DATABASE_URL=sqlite:///./data/ticket_reviewer.db
# Screenshots contain private visible listing data and remain local.
TR_SCREENSHOT_DIRECTORY=data/screenshots
# Safe gate: keep true until the explicit ntfy test succeeds on the user's phone.
TR_DRY_RUN=true
# Ticketmaster Discovery is event-level only here; it does not confirm a buyable pair.
TR_TICKETMASTER_API_KEY=
TR_TICKETMASTER_HTTP_TIMEOUT_SECONDS=10
# SeatGeek event access requires a client ID; the secret is optional for issued apps.
# Its event aggregates do not confirm seat-level pair inventory.
TR_SEATGEEK_CLIENT_ID=
TR_SEATGEEK_CLIENT_SECRET=
TR_SEATGEEK_HTTP_TIMEOUT_SECONDS=10
# StubHub application-only OAuth requires both values and read:events/catalog access.
# Catalog floors remain event-level signals unless future authorized access is added.
TR_STUBHUB_CLIENT_ID=
TR_STUBHUB_CLIENT_SECRET=
TR_STUBHUB_HTTP_TIMEOUT_SECONDS=10
# Optional ntfy push. Use a bearer-like high-entropy 24-128 character topic; never share it.
TR_NTFY_TOPIC=
# Optional ntfy access token; leave blank when unused.
TR_NTFY_ACCESS_TOKEN=
TR_NTFY_HTTP_TIMEOUT_SECONDS=10
